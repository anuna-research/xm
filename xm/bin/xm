#!/usr/bin/env bash
# xm - Cross Memory CLI wrapper
#
# This script sets up the Guile environment and invokes the xm CLI.
# Works both in development (from source tree) and when installed.

set -e

# Determine script directory and mode
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
XM_DIR="$(dirname "$SCRIPT_DIR")"

# Check if we're running from an installed location or development
# Installed: $PREFIX/bin/xm with modules in $PREFIX/share/guile/site/3.0/xm
# Development: xm/bin/xm with modules in xm/guile/xm

if [[ -d "${XM_DIR}/guile/xm" ]]; then
    # Development mode - source tree
    GUILE_MODULES="${XM_DIR}/guile"
    LIB_PATH="${XM_DIR}/target/release"
    MAIN_SCRIPT="${XM_DIR}/guile/xm/main.scm"
elif [[ -d "${XM_DIR}/share/guile/site/3.0/xm" ]]; then
    # Installed mode - PREFIX layout
    GUILE_MODULES="${XM_DIR}/share/guile/site/3.0"
    LIB_PATH="${XM_DIR}/lib"
    MAIN_SCRIPT=""  # Use module system instead
else
    echo "Error: Cannot find xm modules" >&2
    echo "Looked in: ${XM_DIR}/guile/xm (dev) and ${XM_DIR}/share/guile/site/3.0/xm (installed)" >&2
    exit 1
fi

# Use Homebrew Guile installation
HOOT_PREFIX="${HOOT_PREFIX:-/opt/homebrew}"

# Set Guile load path (fibers requires all three paths)
export GUILE_LOAD_PATH="${GUILE_MODULES}:${HOOT_PREFIX}/share/guile/site/3.0:${GUILE_LOAD_PATH:-}"
export GUILE_LOAD_COMPILED_PATH="${HOOT_PREFIX}/lib/guile/3.0/site-ccache:${GUILE_LOAD_COMPILED_PATH:-}"
export GUILE_SYSTEM_EXTENSIONS_PATH="${HOOT_PREFIX}/lib/guile/3.0/extensions:${GUILE_SYSTEM_EXTENSIONS_PATH:-}"

# Set library path for FFI
export XM_LIB_PATH="${LIB_PATH}"

# On macOS, also set DYLD_LIBRARY_PATH
if [[ "$OSTYPE" == "darwin"* ]]; then
    export DYLD_LIBRARY_PATH="${LIB_PATH}:${DYLD_LIBRARY_PATH:-}"
fi

# On Linux, set LD_LIBRARY_PATH
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    export LD_LIBRARY_PATH="${LIB_PATH}:${LD_LIBRARY_PATH:-}"
fi

# Run xm via Guile
# Filter out Guile compilation notes from stderr while preserving real errors
# The notes (";;; note: source file...") are noise for users and pollute output
filter_guile_notes() {
    grep -v '^;;; note:' | grep -v ';;;       newer than compiled'
}

if [[ -n "$MAIN_SCRIPT" ]]; then
    # Development mode - load script directly
    guile --no-auto-compile -e '(@ (xm main) main)' -s "$MAIN_SCRIPT" -- "$@" 2> >(filter_guile_notes >&2)
else
    # Installed mode - use module system
    guile --no-auto-compile -e '(@ (xm main) main)' -c '(use-modules (xm main))' -- "$@" 2> >(filter_guile_notes >&2)
fi
